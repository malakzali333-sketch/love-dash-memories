
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Our Little Universe ❤️</title>

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  background: #10091f;
  color: white;
  font-family: Georgia, serif;
  text-align: center;
}

.screen {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 25px;
  position: relative;
  overflow: hidden;
  background: radial-gradient(circle, #59305f, #241333, #10091f);
}

.stars {
  position: absolute;
  inset: 0;
  background-image:
    radial-gradient(2px 2px at 10% 20%, white 90%, transparent),
    radial-gradient(2px 2px at 80% 30%, white 90%, transparent),
    radial-gradient(2px 2px at 40% 70%, white 90%, transparent),
    radial-gradient(3px 3px at 65% 85%, #ffd7ed 90%, transparent);
  background-size: 200px 200px;
  animation: twinkle 3s infinite alternate;
}

.glow {
  position: absolute;
  width: 240px;
  height: 240px;
  background: #ffb8dd;
  border-radius: 50%;
  filter: blur(90px);
  animation: shine 3s infinite alternate;
}

@keyframes twinkle {
  from { opacity: .2; }
  to { opacity: 1; }
}

@keyframes shine {
  from { opacity: .2; transform: scale(.8); }
  to { opacity: .7; transform: scale(1.3); }
}

.content {
  position: relative;
  z-index: 2;
}

h1 {
  color: #ffd0e7;
  font-size: 36px;
}

input, button {
  padding: 14px 20px;
  border: none;
  border-radius: 30px;
  margin: 10px;
  font-size: 16px;
}

input {
  text-align: center;
}

button {
  background: #f5a9ca;
  color: #32132b;
  cursor: pointer;
}

#error { color: #ffc6df; }

#welcome { display: none; }

.welcome-text {
  animation: appear 2s ease both;
}

@keyframes appear {
  from { opacity: 0; transform: translateY(25px); }
  to { opacity: 1; transform: translateY(0); }
}

#welcome h2 {
  font-size: 25px;
  line-height: 1.6;
}

#memories {
  display: none;
  max-width: 650px;
  margin: auto;
  padding: 25px 15px;
}

section { margin: 45px auto; }

img {
  width: 100%;
  max-width: 450px;
  border-radius: 20px;
  box-shadow: 0 0 25px #d77bab;
}

iframe {
  width: 100%;
  max-width: 450px;
  border: none;
  border-radius: 18px;
}
</style>
</head>

<body>

<!-- PASSWORD PAGE -->
<div id="login" class="screen">
  <div class="stars"></div>
  <div class="glow"></div>

  <div class="content">
    <h1>🚀 Our Little Universe ❤️</h1>
    <p>A little surprise made just for you.</p>

    <input type="password" id="password"
      placeholder="Enter the secret password">

    <br>
    <button onclick="unlock()">Open My Heart ❤️</button>
    <p id="error"></p>
  </div>
</div>

<!-- BIRTHDAY INTRO -->
<div id="welcome" class="screen">
  <div class="stars"></div>
  <div class="glow"></div>

  <div class="content welcome-text">
    <h1>✨ Welcome to 26 ✨</h1>
    <h2>
      Happy 26th Birthday,<br>
      Abdelrahman ❤️
    </h2>
  </div>
</div>

<!-- MEMORIES -->
<div id="memories">

  <!-- SONG FIRST -->
  <section>
    <iframe height="230"
      src="https://www.youtube-nocookie.com/embed/Rtd8yHrlgXY"
      title="Our Song"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen>
    </iframe>
  </section>

  <!-- CHILDHOOD PHOTO -->
  <section>
    <img src="childhood-photo.jpg" alt="Childhood Photo">
  </section>

  <!-- OUR PHOTO -->
  <section>
    <img src="our-photo.jpg" alt="Our Photo">
  </section>

  <!-- FINAL LOVE LETTER IMAGE -->
  <section>
    <img src="love-letter-moon.jpg" alt="My Love Letter">
  </section>

</div>

<script>
function unlock() {
  const password = document.getElementById("password").value;

  if (password === "love") {
    document.getElementById("login").style.display = "none";
    document.getElementById("welcome").style.display = "flex";

    setTimeout(function() {
      document.getElementById("welcome").style.display = "none";
      document.getElementById("memories").style.display = "block";
      window.scrollTo(0, 0);
    }, 5500);

  } else {
    document.getElementById("error").textContent =
      "Wrong password. Try again ❤️";
  }
}
</script>

</body>
</html>
